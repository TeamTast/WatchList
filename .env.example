NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key (sb_publishable_...), never a secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used after Discord membership has been verified.
SUPABASE_SECRET_KEY=
# Repeat the Discord OAuth app credentials here for server-side token refresh.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Market data is server-only so all users share the same cached requests.
MARKET_DATA_PROVIDER=mock
FINNHUB_API_KEY=
EODHD_API_KEY=
MASSIVE_API_KEY=
