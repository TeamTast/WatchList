NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-side realtime prototype provider.
# Use finnhub for free-first WebSocket quotes/trades, mock for local demo.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=mock
NEXT_PUBLIC_FINNHUB_API_KEY=

# Optional server-side market data provider.
# mock keeps the app fully local. finnhub enables REST snapshots. eodhd enables delayed global REST snapshots.
MARKET_DATA_PROVIDER=mock
FINNHUB_API_KEY=
EODHD_API_KEY=
MASSIVE_API_KEY=
