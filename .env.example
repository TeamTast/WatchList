NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional browser-side realtime prototype provider.
# Set these only when you want direct Finnhub WebSocket trades in the browser.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=mock
NEXT_PUBLIC_FINNHUB_API_KEY=

# Optional server-side market data provider.
# finnhub enables server-side REST snapshots without exposing the API key.
MARKET_DATA_PROVIDER=mock
FINNHUB_API_KEY=
EODHD_API_KEY=
MASSIVE_API_KEY=
